# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and build outputs
.venv/
venv/
build/
dist/
*.egg-info/

# Local configuration
.env
.env.*
!.env.example

# Generated data and model outputs
data/raw/*
!data/raw/.gitkeep
!data/raw/animal_counting_dataset/
!data/raw/animal_counting_dataset/**
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/predictions/*
!artifacts/predictions/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/reports/cattle_tracking/
artifacts/reports/cattle_tracking/*
# Small tracking metrics files are committed; per-frame exports are not.
!artifacts/reports/cattle_tracking/step2_metrics.json
artifacts/training/

# Generated tracking videos and per-frame track exports stay out of Git.
# The compact demo payload the frontend animates is small enough to keep.
artifacts/tracking/*
!artifacts/tracking/demo_tracks.json

# Pretrained checkpoints downloaded by Ultralytics at runtime
yolo*.pt

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
